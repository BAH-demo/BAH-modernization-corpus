# =============================================================================
# Dockerfile for Apache OFBiz - Enterprise ERP
# Multi-stage build: Maven + JDK 17 (build) → JRE 17 (runtime)
# =============================================================================

# ---------------------------------------------------------------------------
# Stage 1: Build
# ---------------------------------------------------------------------------
FROM eclipse-temurin:17-jdk AS build

RUN apt-get update && \
    apt-get install -y --no-install-recommends maven && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY modernization-corpus-aggregate/apache-ofbiz/pom.xml ./pom.xml
RUN mvn dependency:go-offline -B || true

COPY modernization-corpus-aggregate/apache-ofbiz/ ./
RUN mvn clean package -DskipTests -B

# ---------------------------------------------------------------------------
# Stage 2: Runtime
# ---------------------------------------------------------------------------
FROM eclipse-temurin:17-jre

LABEL org.opencontainers.image.title="apache-ofbiz" \
      org.opencontainers.image.description="Apache OFBiz Enterprise ERP - modernized to Jakarta EE / Java 17" \
      org.opencontainers.image.vendor="BAH Modernization" \
      org.opencontainers.image.source="https://github.com/BAH-demo/BAH-modernization-corpus" \
      org.opencontainers.image.licenses="Apache-2.0"

RUN groupadd --gid 1001 appuser && \
    useradd  --uid 1001 --gid appuser --shell /bin/false --create-home appuser

WORKDIR /app

COPY --from=build /app/target/*.jar app.jar

RUN chown -R appuser:appuser /app

USER appuser

EXPOSE 8443

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD ["java", "-cp", "app.jar", "java.net.HttpURLConnection"] || exit 1

ENTRYPOINT ["java", "-jar", "app.jar"]
